{
  "name": "rate-ledger",
  "version": "0.1.0",
  "description": "Daily record of every advertised rate the Australian banks publish, and what changed",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "ingest": "tsc && node dist/ingest.js",
    "serve": "tsc && node dist/api.js",
    "test": "tsc && node --test dist/test/*.test.js",
    "db": "psql \"$DATABASE_URL\" -f schema.sql"
  },
  "engines": { "node": ">=20" },
  "dependencies": { "pg": "^8.13.1" },
  "devDependencies": { "@types/node": "^22.10.2", "@types/pg": "^8.11.10", "typescript": "^5.7.2" }
}
